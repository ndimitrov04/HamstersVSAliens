; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HamstersVSAliens"
config/version="0.245"
run/main_scene="res://loading_screen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://hamster.png"
config/windows_native_icon="res://hamster.ico"
run/version="0.245"

[autoload]

ObjectTypes="*res://Scripts/Globals/object_types.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/SphynxMotionBlurToolkit/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

[file_customization]

folder_colors={
"res://Tests/": "gray"
}

